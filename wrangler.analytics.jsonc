{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citilink-analytics",
  "main": "src/analytics/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "shy-snowflake-bcde.cloudflareaccess.com",
    "ACCESS_AUD": "2ae128f443dbdfa52ede5a07b9a5ed912400fdeacfdedda790c776ffcc039b19"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "IMPORTER", "class_name": "ImportCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImportCoordinator"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "citilink-history" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "citilink-analytics",
    "database_id": "de0aad33-fd19-49af-bf68-eabbf7029882",
    "migrations_dir": "migrations/analytics"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": true } }
}
