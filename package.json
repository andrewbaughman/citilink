{
  "name": "citilink-history",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "plan": "node --import tsx scripts/plan.ts",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:unit": "node --import tsx --test --test-isolation=none --test-reporter=spec test/*.test.ts",
    "test:integration": "node --test --test-isolation=none --test-reporter=spec test/integration.mjs",
    "test": "npm run test:unit && npm run build && npm run test:integration",
    "check": "npm run plan && npm run typecheck && npm test",
    "provision": "node scripts/provision.mjs",
    "deploy": "npm run check && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "26.6.6",
    "miniflare": "5.20261023.3-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "undici": "7.30.1",
    "wrangler": "4.156.0"
  }
}
